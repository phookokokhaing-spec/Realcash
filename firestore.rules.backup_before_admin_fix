rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // =========================
    // ADMINS
    // =========================
    match /admins/{uid} {
      // User can read only their own admin record
      allow get: if signedIn() && request.auth.uid == uid;

      // Admin can list admin records
      allow list: if isAdmin();

      // Client cannot create/edit/delete admin records
      allow create, update, delete: if false;
    }

    // =========================
    // USERS
    // =========================
    match /users/{uid} {

      // Admin can view/query all users
      allow list: if isAdmin();

      // Admin can read individual user
      // Normal user can read only own document.
      // If document does not exist, get is allowed so the app
      // can continue to create it.
      allow get: if isAdmin()
        || (
          signedIn()
          && (
            resource == null
            || resource.data.authUid == request.auth.uid
          )
        );

      // New user creation
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.id == uid;

      // Existing user can update own document.
      // authUid cannot be changed by the user.
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == resource.data.authUid
        );

      // Only admin can delete
      allow delete: if isAdmin();
    }

    // =========================
    // SETTINGS
    // =========================
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // WITHDRAW REQUESTS
    // =========================
    match /withdrawRequests/{reqId} {

      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid;

      allow get: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
        );

      allow list: if isAdmin();

      allow update, delete: if isAdmin();
    }


    // =========================
    // TRANSACTIONS
    // =========================
    match /transactions/{txId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =========================
    // WITHDRAWALS (MMK)
    // =========================
    match /withdrawals/{reqId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow get: if isAdmin()
        || (signedIn() && resource.data.authUid == request.auth.uid);

      allow list: if isAdmin()
        || (signedIn() && resource.data.authUid == request.auth.uid);

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================
    // AD WATCHES
    // =========================
    match /adWatches/{docId} {

      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid;

      allow get: if signedIn();

      allow list: if signedIn();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == resource.data.authUid
        );

      allow delete: if isAdmin();
    }
  }
}
