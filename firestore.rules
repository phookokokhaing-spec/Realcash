rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /withdrawRequests/{reqId} {
      allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /adWatches/{docId} {
      allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
      allow read: if signedIn();
      allow update: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
