rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Admin identity is created manually in Firestore after creating the
    // Firebase Authentication email/password account. Clients cannot write it.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // A user is tied to a Firebase anonymous-auth UID. Existing records without
    // authUid may be claimed once; afterwards only that UID or an admin can edit it.
    match /users/{uid} {
      allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow update: if isAdmin()
                    || (signedIn() && (
                      resource.data.authUid == request.auth.uid
                      || (!('authUid' in resource.data) && request.resource.data.authUid == request.auth.uid)
                    ));
      allow delete: if isAdmin();
    }

    // App settings are public-readable, admin-writable.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Users can create/read their own withdrawal requests; admins can review/update all.
    match /withdrawRequests/{reqId} {
      allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Daily leaderboard records.
    match /adWatches/{docId} {
      allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
      allow read: if signedIn();
      allow update: if isAdmin()
                    || (signedIn() && resource.data.authUid == request.auth.uid
                        && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }
  }
}
