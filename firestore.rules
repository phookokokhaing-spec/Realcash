rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow get: if isAdmin() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {

      // Admin can manage all users
      allow read, write: if isAdmin();

      // A signed-in user may check whether their own document exists.
      // If it doesn't exist, the app can then create it.
      allow get: if signedIn()
        && (
          resource == null
          || resource.data.authUid == request.auth.uid
        );

      // User can create only their own Firebase-authenticated document
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid;

      // Existing owner can update their own document.
      // authUid cannot be changed to another account.
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid;

      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /withdrawRequests/{reqId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid;

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /adWatches/{docId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid;

      allow read: if signedIn();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == resource.data.authUid
        );

      allow delete: if isAdmin();
    }
  }
}
