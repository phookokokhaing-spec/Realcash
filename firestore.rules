rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true;
    }

    // ADMINS
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // USERS
    match /users/{uid} {
      allow list: if isAdmin();

      allow get: if isAdmin()
        || (
          signedIn()
          && (
            resource == null
            || resource.data.authUid == request.auth.uid
          )
        );

      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.id == uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == resource.data.authUid
        );

      allow delete: if isAdmin();
    }

    // SETTINGS
    match /settings/{docId} {
      allow read: if docId == 'adminAccess' || signedIn();
      allow write: if isAdmin();
    }

    // LEGACY WITHDRAW REQUESTS
    match /withdrawRequests/{reqId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid;

      allow get: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
        );

      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // TRANSACTIONS
    match /transactions/{txId} {
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow get, list: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // MMK WITHDRAWALS
    match /withdrawals/{reqId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow get: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
        );

      allow list: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // AD WATCHES
    match /adWatches/{docId} {
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid;

      allow get, list: if signedIn();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == resource.data.authUid
        );

      allow delete: if isAdmin();
    }

    // DAILY TOP 3 REWARDS
    // Only Firestore-authorized admins can manage reward records.
    match /dailyTop3Rewards/{rewardId} {
      allow read, write: if isAdmin();
    }
  }
}
